<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="quick_stamp"
        android:enabled="true"
        android:icon="@android:drawable/ic_lock_idle_alarm"
        android:shortcutShortLabel="@string/shortcut_stamp_short"
        android:shortcutLongLabel="@string/shortcut_stamp_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="fi.numeron.vuorovahti"
            android:targetClass="fi.numeron.vuorovahti.MainActivity">
            <extra android:name=" quick_action" android:value="ACTION_STAMP" />
        </intent>
    </shortcut>

    <shortcut
        android:shortcutId="quick_sync"
        android:enabled="true"
        android:icon="@android:drawable/ic_popup_sync"
        android:shortcutShortLabel="@string/shortcut_sync_short"
