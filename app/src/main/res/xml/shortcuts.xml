        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="fi.numeron.vuorovahti"
            android:targetClass="fi.numeron.vuorovahti.MainActivity">
            <extra android:name="quick_action" android:value="ACTION_SYNC" />
        </intent>
